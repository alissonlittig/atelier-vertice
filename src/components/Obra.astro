---
// Elevação esquemática gerada em SVG (sem fotos reais).
const { forma, paleta, id, meet = false } = Astro.props as { forma: number; paleta: [string, string, string]; id: string; meet?: boolean };
const [c1, c2, c3] = paleta;
const bricks = Array.from({ length: 5 }, (_, i) => i);
const brises = Array.from({ length: 22 }, (_, i) => i);
const sheds = Array.from({ length: 5 }, (_, i) => i);
---
<svg viewBox="0 0 800 600" preserveAspectRatio={meet ? "xMidYMid meet" : "xMidYMid slice"} role="img" aria-label="Elevação esquemática do projeto" width="800" height="600">
  <defs>
    <linearGradient id={`s-${id}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color={c1}/><stop offset="1" stop-color="#f4f0e9"/></linearGradient>
    <linearGradient id={`g-${id}`} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color={c2} stop-opacity=".55"/><stop offset="1" stop-color={c2} stop-opacity=".2"/></linearGradient>
  </defs>
  <rect x="-1600" width="4000" height="600" fill={`url(#s-${id})`}/>
  <circle cx="640" cy="150" r="46" fill="#fff" opacity=".55"/>
  <path d="M-1600 430 L-1200 380 L-800 420 L-400 360 L0 430 L120 370 L230 420 L360 340 L520 430 L650 360 L800 420 L1200 360 L1600 430 L2400 400 V470 H-1600Z" fill={c2} opacity=".18"/>
  {forma === 0 && <g>
    <rect x="130" y="250" width="540" height="70" fill={c3}/>
    <rect x="160" y="268" width="360" height="40" fill="#f4f0e9" opacity=".85"/>
    <rect x="130" y="320" width="26" height="150" fill={c2}/><rect x="644" y="320" width="26" height="150" fill={c2}/>
    <rect x="200" y="380" width="260" height="90" fill={c2} opacity=".45"/>
    <g stroke={c3} stroke-width="3" opacity=".6"><path d="M90 470 V380 M70 470 V400 M720 470 V360 M745 470 V390"/></g>
  </g>}
  {forma === 1 && <g>
    <rect x="300" y="90" width="200" height="380" fill={c3}/>
    {brises.map((i) => <rect x={308 + (i % 2) * 94} y={100 + Math.floor(i / 2) * 33} width="88" height="6" fill="#f4f0e9" opacity=".8"/>)}
    <rect x="240" y="400" width="320" height="70" fill={c2} opacity=".6"/>
    <rect x="270" y="410" width="260" height="60" fill="#f4f0e9" opacity=".3"/>
  </g>}
  {forma === 2 && <g>
    {bricks.map((i) => <path d={`M${100 + i * 120} 470 V340 A60 60 0 0 1 ${220 + i * 120} 340 V470Z`} fill={c2} opacity={0.5 + i * 0.1}/>)}
    <rect x="60" y="470" width="680" height="14" fill={c3}/>
    <rect x="60" y="486" width="680" height="10" fill="#8cb0b8" opacity=".5"/>
  </g>}
  {forma === 3 && <g>
    <rect x="160" y="230" width="300" height="240" fill="#efe7d6"/>
    <path d="M140 230 L310 150 L480 230Z" fill={c3}/>
    {[0, 1, 2].map((i) => <rect x={190 + i * 90} y="270" width="46" height="70" fill={c3} opacity=".75"/>)}
    <rect x="190" y="390" width="46" height="80" fill={c3} opacity=".75"/>
    <rect x="470" y="330" width="210" height="140" fill={c2}/>
    <g stroke="#f4f0e9" stroke-width="3" opacity=".6">{Array.from({ length: 8 }, (_, i) => <path d={`M${490 + i * 24} 330 V470`}/>)}</g>
  </g>}
  {forma === 4 && <g>
    {[0, 1, 2].map((i) => <g><path d={`M${90 + i * 230} 360 H${290 + i * 230} L${270 + i * 230} 330 H${110 + i * 230}Z`} fill={c3}/><rect x={110 + i * 230} y="360" width="180" height="110" fill={c2} opacity=".5"/><rect x={125 + i * 230} y="380" width="70" height="90" fill="#f4f0e9" opacity=".7"/></g>)}
    <path d="M0 470 Q200 440 400 470 T800 470 V520 H0Z" fill={c2} opacity=".35"/>
  </g>}
  {forma === 5 && <g>
    <path d="M110 470 V200 Q110 150 190 150 H330 V470Z" fill={c3}/>
    <path d="M470 470 V150 H610 Q690 150 690 200 V470Z" fill={c3}/>
    {Array.from({ length: 8 }, (_, i) => <rect x="130" y={175 + i * 36} width="180" height="14" fill="#f4f0e9" opacity=".65"/>)}
    {Array.from({ length: 8 }, (_, i) => <rect x="490" y={175 + i * 36} width="180" height="14" fill="#f4f0e9" opacity=".65"/>)}
    <rect x="340" y="400" width="120" height="70" fill={c2} opacity=".6"/>
  </g>}
  {forma === 6 && <g>
    <rect x="100" y="330" width="600" height="140" fill={c3}/>
    {sheds.map((i) => <path d={`M${100 + i * 120} 330 L${100 + i * 120} 270 L${220 + i * 120} 330Z`} fill={c2}/>)}
    {Array.from({ length: 6 }, (_, i) => <rect x={130 + i * 95} y="380" width="60" height="90" fill="#f4f0e9" opacity=".7"/>)}
  </g>}
  {forma === 7 && <g>
    <rect x="40" y="380" width="170" height="90" fill={c2} opacity=".6"/><rect x="590" y="380" width="170" height="90" fill={c2} opacity=".6"/>
    <rect x="150" y="250" width="500" height="110" fill={c3}/>
    <g stroke="#f4f0e9" stroke-width="3" opacity=".7">{Array.from({ length: 11 }, (_, i) => <path d={`M${170 + i * 44} 262 V348`}/>)}</g>
    <path d="M150 360 L400 470 L650 360" stroke={c3} stroke-width="6" fill="none"/>
    <path d="M210 470 Q400 520 590 470 V500 H210Z" fill="#8cb0b8" opacity=".5"/>
  </g>}
  <rect x="-1600" y="470" width="4000" height="130" fill={`url(#g-${id})`}/>
  <path d="M-1600 470 H2400" stroke={c3} stroke-width="2"/>
</svg>
<style>svg{display:block;width:100%;height:100%;overflow:visible}</style>
