---
import Obra from './Obra.astro';
const { o } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<a class="card" href={`${b}/obras/${o.slug}/`} data-tipo={o.tipo} data-status={o.status} data-ano={o.ano}>
  <div class="im"><Obra forma={o.forma} paleta={o.paleta} id={o.slug}/></div>
  <div class="meta"><span>{o.tipo}</span><span>{o.cidade} · {o.ano}</span></div>
  <h3>{o.nome}</h3><p>{o.resumo}</p>
</a>
