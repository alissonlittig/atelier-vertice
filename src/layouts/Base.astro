---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '../styles/global.css';
const { title, desc = 'Atelier Vértice — arquitetura e construção com rigor construtivo e desenho contemporâneo. Projeto de exemplo, dados fictícios.' } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [['obras/', 'Obras'], ['sobre/', 'Escritório'], ['processo/', 'Processo'], ['contato/', 'Contato']];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{title}</title><meta name="description" content={desc}>
  <meta name="theme-color" content="#f3efe7">
  <link rel="icon" href={`${b}/favicon.svg`} type="image/svg+xml">
</head>
<body>
  <a class="skip" href="#main">Pular para o conteúdo</a>
  <header class="top">
    <a class="brand" href={`${b}/`} aria-label="Atelier Vértice, início"><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M2 3 L11 19 L20 3" fill="none" stroke="currentColor" stroke-width="2"/></svg><span>Atelier Vértice</span></a>
    <nav aria-label="Principal">
      {nav.map(([h, l]) => <a href={`${b}/${h}`} aria-current={path.includes('/' + h) ? 'page' : undefined}>{l}</a>)}
    </nav>
  </header>
  <main id="main"><slot /></main>
  <footer class="foot">
    <div><strong>Atelier Vértice</strong><p>Arquitetura e construção. Curitiba · São Paulo.</p></div>
    <div><p>Projeto de demonstração criado por Alisson Littig. Escritório, obras, nomes e números são fictícios.</p><a href="https://alissonlittig.github.io/">Ver portfólio</a></div>
  </footer>
</body>
</html>
